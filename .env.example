# Neon Postgres - pooled connection (auto-set by Vercel Marketplace)
POSTGRES_URL="postgresql://..."

# Neon Postgres - direct connection for migrations (auto-set by Vercel Marketplace)
POSTGRES_URL_NON_POOLING="postgresql://..."

# 4-digit PIN — used only to gate the Access section in Settings
APP_PIN="1234"

# Better Auth — generate secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Your app's public URL (e.g. https://yourapp.vercel.app, or http://localhost:3000 locally)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth — create at console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Your Google account email — existing data is backfilled to this user
OWNER_EMAIL=""
NEXT_PUBLIC_OWNER_EMAIL=""

# Stripe Payment Link for the support prompt (opens in new tab, no webhook needed)
NEXT_PUBLIC_STRIPE_SUPPORT_URL=""

# Dev-only: allow pairing a Blend session with yourself (same user on two
# devices). Leave unset in production.
ALLOW_BLEND_SOLO=""
